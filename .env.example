# Required to run the Discord bot.
DISCORD_TOKEN=

# Required for `/time set location`; obtain this from Google Maps Platform.
GOOGLE_API_KEY=

# Use an absolute path outside the repository in production.
TIMEZONE_DATA_FILE=/var/lib/timezone/timezones.json

# Required only when registering slash commands.
DISCORD_CLIENT_ID=

# Retained from the previous deployment; not used by the current Gateway bot.
PUBLIC_KEY=
